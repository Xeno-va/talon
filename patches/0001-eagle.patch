+// Eagle works command first: pick the command, then click the part. KiCad's
+// edit commands act on what is already selected, so clicked on a toolbar with
+// nothing selected they did nothing. For these the toolbar starts KiCad's own
+// picker instead, and every click on the drawing runs the command on what is
+// under it, until Escape, as in Eagle.
+static const std::set<std::string> EAGLE_VERBS = {
+    "common.Interactive.duplicate",           "common.Interactive.delete",
+    "pcbnew.InteractiveMove.move",            "pcbnew.InteractiveEdit.flip",
+    "pcbnew.InteractiveEdit.rotateCcw",       "pcbnew.InteractiveEdit.properties",
+    "pcbnew.EditorControl.toggleLock",        "pcbnew.InteractiveEdit.swapPadNets",
+    "pcbnew.InteractiveEdit.swapGateNets",    "pcbnew.InteractiveRouter.BreakTrack",
+    "pcbnew.InteractiveSelection.unrouteSelected", "pcbnew.EditorControl.highlightNetSelection",
+    "eeschema.InteractiveMove.move",          "eeschema.InteractiveEdit.mirrorV",
+    "eeschema.InteractiveEdit.rotateCCW",     "eeschema.InteractiveEdit.properties",
+    "eeschema.InteractiveEdit.swapPins",      "eeschema.InteractiveEdit.editReference",
+    "eeschema.InteractiveEdit.editValue",     "eeschema.InteractiveEdit.changeSymbol",
+    "eeschema.InteractiveEdit.symbolProperties", "eeschema.InteractiveEdit.breakWire",
+};
+
+// These start an interactive tool of their own, which ends the picking.
+static const std::set<std::string> EAGLE_VERBS_TAKE_OVER = {
+    "common.Interactive.duplicate", "pcbnew.InteractiveMove.move", "eeschema.InteractiveMove.move",
+};
+
+
+static bool startEagleVerb( TOOL_MANAGER* aMgr, const TOOL_ACTION* aAction )
+{
+    if( !EAGLE_VERBS.count( aAction->GetName() ) )
+        return false;
+
+    TOOLS_HOLDER* holder = aMgr->GetToolHolder();
+
+    if( !holder || !holder->GetCurrentSelection().Empty() )
+        return false;   // something is already selected: act on it the KiCad way
+
+    TOOL_BASE* tool = aMgr->FindTool( "pcbnew.InteractivePicker" );
+
+    if( !tool )
+        tool = aMgr->FindTool( "common.InteractivePicker" );
+
+    PICKER_TOOL_BASE* picker = dynamic_cast<PICKER_TOOL_BASE*>( tool );
+
+    if( !picker )
+        return false;
+
+    const bool takeOver = EAGLE_VERBS_TAKE_OVER.count( aAction->GetName() );
+
+    picker->SetCursor( KICURSOR::BULLSEYE );
+    picker->SetClickHandler(
+            [aMgr, aAction, takeOver]( const VECTOR2D& aPos ) -> bool
+            {
+                // End the pick first: KiCad's edit commands do nothing while another
+                // interactive tool is running. With nothing selected, the command then
+                // takes the item under the cursor, as a hotkey would.
+                aMgr->RunAction( ACTIONS::selectionClear );
+                aMgr->PostAction( *aAction );
+
+                // Then pick again for the next item, the way an Eagle command stays
+                // active until Escape. Move and copy hand over to their own tool.
+                if( !takeOver )
+                {
+                    wxTheApp->CallAfter(
+                            [aMgr, aAction]()
+                            {
+                                startEagleVerb( aMgr, aAction );
+                            } );
+                }
+
+                return false;
+            } );
+
+    // The picker takes the event that started it as a pointer to const; any other
+    // type is refused and the picker quits at once.
+    const TOOL_EVENT source = aAction->MakeEvent();
+    aMgr->RunAction( ACTIONS::pickerTool, &source );
+    return true;
+}
